{
  "name": "portal-bedoccupancy",
  "version": "1.7.4-snapshot",
  "overrides": {
    "browserslist": "4.28.7",
    "fast-uri": "3.1.5",
    "watchpack": "2.5.2"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --coverage && npm run fix-junit-time",
    "test-local": "vitest",
    "test-local-browser": "vitest --browser.headless=false",
    "fix-junit-time": "node scripts/fix-junit-time.mjs",
    "clean-api": "rimraf src/api",
    "clean-cache": "rimraf .angular/cache && echo Cache cleared - next build will be slower but clean",
    "build-fresh": "npm run clean-cache && npm run build",
    "build-api": "npm run clean-api && openapi-generator-cli generate",
    "build-api-lokal": "openapi-generator-cli generate",
    "docker": "docker build -t europe-west3-docker.pkg.dev/gematik-all-infra-prod/demis-dev/portal-bedoccupancy:latest ."
  },
  "private": true,
